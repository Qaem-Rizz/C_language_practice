#include<stdio.h>
int main(){
    char ch;
    printf("enter the character: ");
    scanf("%c" , &ch);

    if(ch>='a' && ch<='z'){
        printf("lower case \n");
    }
    else if ( ch>='A'&& ch<='Z'){
        printf("Upper case \n");
    }
    else{
        printf("Not an English letter \n");
    }
    return 0;
}
